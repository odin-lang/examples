IDC_ACCELERATOR_TABLE ACCELERATORS
BEGIN
	"N",      IDM_NEW,             VIRTKEY,  CONTROL
	"O",      IDM_OPEN,            VIRTKEY,  CONTROL
	"S",      IDM_SAVE,            VIRTKEY,  CONTROL
	"S",      IDM_SAVE_AS,         VIRTKEY,  CONTROL, SHIFT
	VK_F12,   IDM_ABOUT,           VIRTKEY
END

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

IDM_MAIN_MENU MENU
BEGIN
	POPUP "&Bestand"
	BEGIN
		MENUITEM "&Reset naar beginpositie", IDM_RESET_TO_STARTING_POSITION
		MENUITEM SEPARATOR
		MENUITEM "&Nieuw\tCtrl+N", IDM_NEW
		MENUITEM "&Openen...\tCtrl+O", IDM_OPEN
		MENUITEM "&Opslaan\tCtrl+S", IDM_SAVE
		MENUITEM "Opslaan &als...\tCtrl+Shift+S", IDM_SAVE_AS
		MENUITEM SEPARATOR
		MENUITEM "A&fsluiten", IDM_EXIT
	END
	POPUP "&Opties"
	BEGIN
		MENUITEM "Geluid a&fspelen", IDM_PLAY_SOUND, CHECKED
		MENUITEM SEPARATOR
		MENUITEM "&Normale vormgeving", IDM_VISUALS_NORMAL
		MENUITEM "&Ginger-vormgeving", IDM_VISUALS_GINGER
	END
	POPUP "&Help"
	BEGIN
		MENUITEM "&Over\tF12", IDM_ABOUT
	END
END

