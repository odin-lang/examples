// Read this file as UTF-8
#pragma code_page(65001)

#include <winuser.h>
#include <CommCtrl.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// NOTE: The icon with the lowest ID value becomes the executable's main icon (displayed in Windows Explorer).
IDI_MAIN           ICON    "icon.ico"
IDB_ABOUT          BITMAP  "about.bmp"
IDR_PIECES_NORMAL  RCDATA  "piecesnormal.png"
IDR_PIECES_GINGER  RCDATA  "billchess.png"
IDW_CLACK          WAVE    "clack.wav"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDM_MAIN_MENU MENU
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&Reset to starting position", IDM_RESET_TO_STARTING_POSITION
		MENUITEM SEPARATOR
		MENUITEM "&New\tCtrl+N", IDM_NEW
		MENUITEM "&Open...\tCtrl+O", IDM_OPEN
		MENUITEM "&Save\tCtrl+S", IDM_SAVE
		MENUITEM "Save &As...\tCtrl+Shift+S", IDM_SAVE_AS
		MENUITEM SEPARATOR
		MENUITEM "E&xit", IDM_EXIT
	END
	POPUP "&Options"
	BEGIN
		MENUITEM "Play &sound", IDM_PLAY_SOUND, CHECKED
		MENUITEM SEPARATOR
		MENUITEM "&Normal visuals", IDM_VISUALS_NORMAL
		MENUITEM "&Ginger visuals", IDM_VISUALS_GINGER
	END
	POPUP "&Help"
	BEGIN
		MENUITEM "&About\tF12", IDM_ABOUT
	END
END

// Help hints for IDM_MAIN_MENU
STRINGTABLE
BEGIN
	IDM_NEW                            "Creates a new position."
	IDM_OPEN                           "Opens a position from a file."
	IDM_SAVE                           "Saves the current position to the current file."
	IDM_SAVE_AS                        "Saves the current position to a new file."
	IDM_EXIT                           "Closes the application."
	IDM_RESET_TO_STARTING_POSITION     "Discards the current position and reloads the starting position."
	IDM_ABOUT                          "Shows information about this application."
	IDM_PLAY_SOUND                     "Toggles whether to play a sound when a piece is placed."
END

IDD_MAIN DIALOGEX 0, 0, 410, 320
CAPTION "FEN tool"
STYLE WS_OVERLAPPEDWINDOW | DS_SHELLFONT | DS_CENTER
FONT 8, "MS Shell Dlg", 0, 0, 0x0
MENU IDM_MAIN_MENU
BEGIN
	LTEXT "FEN:", IDC_STATIC, 11, 10, 248, 10
	EDITTEXT IDC_TEXTBOX_FEN, 10, 22, 390, 12, ES_AUTOHSCROLL

	RADIOBUTTON "White to move", IDC_RADIOBUTTON_WHITE_TO_MOVE, 10, 50, 120, 12
	RADIOBUTTON "Black to move", IDC_RADIOBUTTON_BLACK_TO_MOVE, 10, 62, 120, 12

	CHECKBOX "White can castle kingside",  IDC_CHECKBOX_WHITE_CASTLE_KINGSIDE,  10, 80,  120, 12
	CHECKBOX "White can castle queenside", IDC_CHECKBOX_WHITE_CASTLE_QUEENSIDE, 10, 92,  120, 12
	CHECKBOX "Black can castle kingside",  IDC_CHECKBOX_BLACK_CASTLE_KINGSIDE,  10, 104, 120, 12
	CHECKBOX "Black can castle queenside", IDC_CHECKBOX_BLACK_CASTLE_QUEENSIDE, 10, 116, 120, 12

	LTEXT "En passant target square:", IDC_STATIC, 11, 134, 120, 12
	EDITTEXT IDC_TEXTBOX_EN_PASSANT_TARGET_SQUARE, 10, 146, 90, 12
	PUSHBUTTON "❌", IDC_BUTTON_CLEAR_EN_PASSANT, 110, 146, 16, 12

	LTEXT "Halfmove clock:", IDC_STATIC, 11, 160, 120, 12
	EDITTEXT IDC_TEXTBOX_HALFMOVE_CLOCK, 10, 172, 120, 12, ES_NUMBER

	LTEXT "Fullmove number:", IDC_STATIC, 11, 190, 120, 12
	EDITTEXT IDC_TEXTBOX_FULLMOVE_NUMBER, 10, 202, 120, 12, ES_NUMBER

	CONTROL "", IDC_BOARD_CONTROL, "board_control", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 140, 50, 260, 260

	CONTROL "", IDC_STATUSBAR, STATUSCLASSNAME, WS_CHILD | WS_VISIBLE | SBARS_SIZEGRIP, 0, 115, 300, 15
END

IDM_BOARD_CONTEXT_MENU MENU
BEGIN
	POPUP ""
	BEGIN
		MENUITEM "xx", IDM_SQUARE_INFO, INACTIVE
		MENUITEM SEPARATOR
		MENUITEM "&Clear square", IDM_CLEAR_SQUARE
		MENUITEM SEPARATOR
		POPUP "&Pawn"
		BEGIN
			MENUITEM "&White", IDM_PAWN_WHITE
			MENUITEM "&Black", IDM_PAWN_BLACK
		END
		POPUP "&Bishop"
		BEGIN
			MENUITEM "&White", IDM_BISHOP_WHITE
			MENUITEM "&Black", IDM_BISHOP_BLACK
		END
		POPUP "K&night"
		BEGIN
			MENUITEM "&White", IDM_KNIGHT_WHITE
			MENUITEM "&Black", IDM_KNIGHT_BLACK
		END
		POPUP "&Rook"
		BEGIN
			MENUITEM "&White", IDM_ROOK_WHITE
			MENUITEM "&Black", IDM_ROOK_BLACK
		END
		POPUP "&Queen"
		BEGIN
			MENUITEM "&White", IDM_QUEEN_WHITE
			MENUITEM "&Black", IDM_QUEEN_BLACK
		END
		POPUP "&King"
		BEGIN
			MENUITEM "&White", IDM_KING_WHITE
			MENUITEM "&Black", IDM_KING_BLACK
		END
		MENUITEM SEPARATOR
		MENUITEM "Set &En Passant target square", IDM_SET_EN_PASSANT_TARGET_SQUARE
		MENUITEM "Toggle castling right", IDM_TOGGLE_CASTLING_RIGHT
	END
END

// Help hints for IDM_BOARD_CONTEXT_MENU
STRINGTABLE
BEGIN
	IDM_SQUARE_INFO                    "Displays the selected square."
	IDM_CLEAR_SQUARE                   "Removes the piece from the selected square."
	IDM_ROOK_WHITE                     "Sets a rook for white on the selected square."
	IDM_KNIGHT_WHITE                   "Sets a knight for white on the selected square."
	IDM_BISHOP_WHITE                   "Sets a bishop for white on the selected square."
	IDM_QUEEN_WHITE                    "Sets a queen for white on the selected square."
	IDM_KING_WHITE                     "Sets a king for white on the selected square."
	IDM_PAWN_WHITE                     "Sets a pawn for white on the selected square."
	IDM_ROOK_BLACK                     "Sets a rook for black on the selected square."
	IDM_KNIGHT_BLACK                   "Sets a knight for black on the selected square."
	IDM_BISHOP_BLACK                   "Sets a bishop for black on the selected square."
	IDM_QUEEN_BLACK                    "Sets a queen for black on the selected square."
	IDM_KING_BLACK                     "Sets a king for black on the selected square."
	IDM_PAWN_BLACK                     "Sets a pawn for black on the selected square."
	IDM_SET_EN_PASSANT_TARGET_SQUARE   "Sets this square as the target for a possible en passant capture."
	IDM_TOGGLE_CASTLING_RIGHT          "Toggles the castling right associated with the rook on the selected square."
END

IDD_ABOUT DIALOGEX 0, 0, 150, 70
CAPTION "About"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_SHELLFONT
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	DEFPUSHBUTTON "OK", IDOK, 80, 45, 60, 15
	RTEXT "FEN tool\r\nDemo project", IDC_STATIC, 80, 10, 60, 20
END

