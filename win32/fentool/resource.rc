IDD_MAIN DIALOGEX 0, 0, 410, 320
CAPTION "FEN tool"
STYLE WS_OVERLAPPEDWINDOW | DS_SHELLFONT | DS_CENTER
FONT 8, "MS Shell Dlg", 0, 0, 0x0
MENU IDM_MAIN_MENU
BEGIN
	LTEXT "FEN:", IDC_STATIC, 11, 10, 248, 10
	EDITTEXT IDC_TEXTBOX_FEN, 10, 22, 390, 12, ES_AUTOHSCROLL

	RADIOBUTTON "Wit aan zet", IDC_RADIOBUTTON_WHITE_TO_MOVE, 10, 50, 120, 12
	RADIOBUTTON "Zwart aan zet", IDC_RADIOBUTTON_BLACK_TO_MOVE, 10, 62, 120, 12

	CHECKBOX "Wit mag kort rokeren",  IDC_CHECKBOX_WHITE_CASTLE_KINGSIDE,  10, 80,  120, 12
	CHECKBOX "Wit mag lang rokeren", IDC_CHECKBOX_WHITE_CASTLE_QUEENSIDE, 10, 92,  120, 12
	CHECKBOX "Zwart mag kort rokeren",  IDC_CHECKBOX_BLACK_CASTLE_KINGSIDE,  10, 104, 120, 12
	CHECKBOX "Zwart mag lang rokeren", IDC_CHECKBOX_BLACK_CASTLE_QUEENSIDE, 10, 116, 120, 12

	LTEXT "En-passantdoelveld:", IDC_STATIC, 11, 134, 120, 12
	EDITTEXT IDC_TEXTBOX_EN_PASSANT_TARGET_SQUARE, 10, 146, 90, 12
	PUSHBUTTON "❌", IDC_BUTTON_CLEAR_EN_PASSANT, 110, 146, 16, 12

	LTEXT "Halfzettenklok:", IDC_STATIC, 11, 160, 120, 12
	EDITTEXT IDC_TEXTBOX_HALFMOVE_CLOCK, 10, 172, 120, 12, ES_NUMBER

	LTEXT "Volledige zet:", IDC_STATIC, 11, 190, 120, 12
	EDITTEXT IDC_TEXTBOX_FULLMOVE_NUMBER, 10, 202, 120, 12, ES_NUMBER

	CONTROL "", IDC_BOARD_CONTROL, "board_control", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 140, 50, 260, 260

	CONTROL "", IDC_STATUSBAR, STATUSCLASSNAME, WS_CHILD | WS_VISIBLE | SBARS_SIZEGRIP, 0, 115, 300, 15
END

IDM_BOARD_CONTEXT_MENU MENU
BEGIN
	POPUP ""
	BEGIN
		MENUITEM "xx", IDM_SQUARE_INFO, INACTIVE
		MENUITEM SEPARATOR
		MENUITEM "Vak &leegmaken", IDM_CLEAR_SQUARE
		MENUITEM SEPARATOR
		POPUP "&Pion"
		BEGIN
			MENUITEM "&Wit", IDM_PAWN_WHITE
			MENUITEM "&Zwart", IDM_PAWN_BLACK
		END
		POPUP "&Loper"
		BEGIN
			MENUITEM "&Wit", IDM_BISHOP_WHITE
			MENUITEM "&Zwart", IDM_BISHOP_BLACK
		END
		POPUP "&Paard"
		BEGIN
			MENUITEM "&Wit", IDM_KNIGHT_WHITE
			MENUITEM "&Zwart", IDM_KNIGHT_BLACK
		END
		POPUP "&Toren"
		BEGIN
			MENUITEM "&Wit", IDM_ROOK_WHITE
			MENUITEM "&Zwart", IDM_ROOK_BLACK
		END
		POPUP "&Dame"
		BEGIN
			MENUITEM "&Wit", IDM_QUEEN_WHITE
			MENUITEM "&Zwart", IDM_QUEEN_BLACK
		END
		POPUP "K&oning"
		BEGIN
			MENUITEM "&Wit", IDM_KING_WHITE
			MENUITEM "&Zwart", IDM_KING_BLACK
		END
		MENUITEM SEPARATOR
		MENUITEM "En-passantdoelveld in&stellen", IDM_SET_EN_PASSANT_TARGET_SQUARE
		MENUITEM "Rokaderecht omschakelen", IDM_TOGGLE_CASTLING_RIGHT
	END
END

